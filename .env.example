# Server
APP_ADDR=:8080
APP_BIND=127.0.0.1
APP_PORT=8080
# Only "development" or "production" are accepted; unset means production.
# development enables insecure local fallbacks (built-in JWT secret, admin/admin,
# verification codes printed to the log). Never use it on a reachable host.
# production additionally requires JWT_SECRET >= 32 chars, ADMIN_PASSWORD >= 16
# chars and real SMTP settings.
APP_ENV=development
SHUTDOWN_TIMEOUT=15s
# Admin panel + metrics listen on a separate port that compose publishes to
# 127.0.0.1 only (ADR 0023). Open http://127.0.0.1:9090/admin/ locally, or via
# `ssh -L 9090:127.0.0.1:9090 <server>` in production. Outside Docker the app
# itself binds ADMIN_ADDR, default 127.0.0.1:9090.
ADMIN_PORT=9090

# MySQL (Docker Compose defaults already match these values)
MYSQL_DATABASE=paper_assistant
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=paper
MYSQL_PASSWORD=paper
MYSQL_ROOT_PASSWORD=root
MYSQL_DSN=paper:paper@tcp(mysql:3306)/paper_assistant?parseTime=true&charset=utf8mb4&loc=Local
MYSQL_CONNECT_TIMEOUT=60s

# Adminer database web UI. Optional, Compose profile "tools".
# Keep ADMINER_BIND on loopback: Adminer grants full database access.
ADMINER_BIND=127.0.0.1
ADMINER_PORT=8081
ADMINER_DESIGN=pepa-linha-dark

# Redis stores verification/rate-limit coordination only; it is not a durable account store.
# Docker Compose uses redis:6379 internally and does not publish Redis to the host.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Leave empty when directly exposed.
TRUSTED_PROXY_CIDRS=

# QQ SMTP verification mail.
# Development may use SMTP_MODE=log; it logs only the six-digit code and must never be used in production.
# Production must use SMTP_MODE=smtp. SMTP_AUTH_CODE is the QQ Mail SMTP authorization code,
# NOT the QQ login password. Create it in QQ Mail settings and never commit or print it.
# QQ defaults to smtp.qq.com:465 with implicit TLS. Use starttls only with a QQ-supported port.
SMTP_MODE=log
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_FROM=
SMTP_AUTH_CODE=
SMTP_TLS_MODE=implicit
SMTP_TIMEOUT=15s

# Admin. Change these outside local development.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Platform account JWT and verification secrets. Both require long random values in production,
# e.g. `openssl rand -hex 32`; leaked values permit token forgery or offline code guessing.
JWT_SECRET=
JWT_TTL=24h
VERIFICATION_PEPPER=
VERIFICATION_TTL=10m
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_AFTER=60s
VERIFICATION_EMAIL_HOURLY_LIMIT=5
VERIFICATION_IP_HOURLY_LIMIT=20
VERIFICATION_GLOBAL_HOURLY_LIMIT=200
VERIFICATION_RATE_WINDOW=1h

# Confirmed server-side rollout switches. Production requires email verification and cost breaker.
PLATFORM_OPEN_REGISTRATION_ENABLED=true
PLATFORM_GUEST_ACCESS_ENABLED=true
PLATFORM_GUEST_DEEP_READ_ENABLED=true
PLATFORM_GUEST_IMPORT_ENABLED=true
PLATFORM_EMAIL_VERIFICATION_REQUIRED=true
PLATFORM_COST_BREAKER_ENABLED=true

# Cost and security defaults from Spec 0003.
PLATFORM_COST_HOURLY_USD=2
PLATFORM_COST_DAILY_USD=10
# Per client IP, across all public /api/ routes.
PLATFORM_API_PER_MINUTE=60
# Failed logins within the window lock one email (even with the right password)
# or one client IP (password spraying). Must be IP limit >= email limit.
PLATFORM_LOGIN_FAILURE_LIMIT=5
PLATFORM_LOGIN_IP_FAILURE_LIMIT=20
PLATFORM_LOGIN_FAILURE_WINDOW=15m

# QQ official bot. Leave disabled until AppID/AppSecret are filled.
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
QQ_API_BASE=https://api.bot.qq.com
QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
QQ_GATEWAY_URL=
QQ_INTENTS=33554432
QQ_RECONNECT_MIN=2s
QQ_RECONNECT_MAX=30s

# paperscraper sidecar (jannisborn/paperscraper v1.0.0)
PAPERSCRAPER_URL=http://paperscraper:8090
PAPERSCRAPER_RESULT_LIMIT=10
PAPERSCRAPER_TIMEOUT=90s
PAPERSCRAPER_MAX_RESULTS=100
# Maximum arXiv records scanned to refill results after excluding seen papers.
PAPERSCRAPER_MAX_SCAN_RESULTS=500
PAPERSCRAPER_ARXIV_DELAY_SECONDS=3
PAPERSCRAPER_ARXIV_RETRIES=3
# Citation enrichment uses paperscraper's Semantic Scholar helper and is slower.
PAPERSCRAPER_CITATIONS=false
# Set only when arXiv needs a proxy. Use host.docker.internal for a proxy running
# on the host, e.g. http://host.docker.internal:7897. Empty means direct.
PAPERSCRAPER_HTTP_PROXY=
PAPERSCRAPER_HTTPS_PROXY=

# IEEE source via OpenAlex (ADR 0018). Both keys are optional and free.
# Without OPENALEX_API_KEY the daily budget is $0.10 (~100 keyword searches);
# a free key raises it to $1 (~1000). Get one at openalex.org (Settings -> API key), or
# POST {"email": "..."} to https://api.openalex.org/api-keys and click the emailed link.
# The key returns 403 key_not_activated until that email link is clicked.
OPENALEX_API_KEY=
# Optional; fills abstracts OpenAlex lacks. Keyless calls share a public rate limit.
SEMANTIC_SCHOLAR_API_KEY=
PAPERSCRAPER_IEEE_TIMEOUT_SECONDS=30

# DeepSeek
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=180s
# Current deepseek-flash peak prices in USD per 1M tokens; off-peak is half.
DEEPSEEK_PEAK_INPUT_PER_M=0.30
DEEPSEEK_PEAK_CACHE_HIT_PER_M=0.006
DEEPSEEK_PEAK_OUTPUT_PER_M=1.20

# Full-text extraction
FULLTEXT_DIR=/app/data/fulltext
PDFTOTEXT_BIN=pdftotext
MAX_PDF_BYTES=52428800
