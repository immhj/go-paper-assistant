# Server-side .env for docker-compose.prod.yml. Copy to /opt/paper-assistant/.env on the
# server, fill every value, then `chmod 600 .env`. Never commit the filled file.
#
# Generate secrets on the server, e.g.:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# --- Edge / TLS (ADR 0022) ---
PUBLIC_IP=203.0.113.10
ACME_EMAIL=you@example.com

# --- Release (written by scripts/release.ps1) ---
IMAGE_TAG=local

# --- App ---
APP_ENV=production
ADMIN_USER=operator
ADMIN_PASSWORD=change-me-to-at-least-16-chars
JWT_SECRET=change-me-to-at-least-32-random-characters
VERIFICATION_PEPPER=change-me-to-at-least-32-random-characters

# --- Data stores (internal network only) ---
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DSN=paper:change-me@tcp(mysql:3306)/paper_assistant?parseTime=true&charset=utf8mb4&loc=Local
REDIS_PASSWORD=change-me

# --- Mail (required in production) ---
SMTP_MODE=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS_MODE=implicit
SMTP_FROM=you@qq.com
SMTP_AUTH_CODE=

# --- Model ---
DEEPSEEK_API_KEY=
PLATFORM_COST_HOURLY_USD=1
PLATFORM_COST_DAILY_USD=5

# --- QQ bot (optional) ---
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=

# --- Paper sources (optional) ---
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
